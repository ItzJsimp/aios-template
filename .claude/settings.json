{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "cache-clock@aios-mods": true,
    "limit-watch@aios-mods": true,
    "quick-replies@aios-mods": true
  },
  "extraKnownMarketplaces": {
    "aios-mods": {
      "source": {
        "path": "./mods",
        "source": "directory"
      }
    }
  },
  "includeGitInstructions": true,
  "outputStyle": "normal",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(pwsh -NoProfile -File scripts/*)",
      "Bash(pwsh -NoProfile -Command *)",
      "Bash(python scripts/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Edit",
      "Write",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(Remove-Item -Recurse -Force:*)"
    ]
  }
}
